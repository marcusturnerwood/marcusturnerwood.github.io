_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/

# Work-in-progress articles (Jekyll drafts: unpublished, excluded from the built site)
_drafts/

# OS cruft
.DS_Store
Thumbs.db
Desktop.ini

# Python bytecode cache (tools/edit_server.py)
__pycache__/
*.pyc
.venv/
venv/

# Ruby/Jekyll
.bundle/
vendor/bundle/

# Secrets (password-protected project content, etc.)
.env
.env.*

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Local Claude Code settings (machine-specific, already covered by most users'
# global gitignore, but kept here too so a fresh clone doesn't accidentally track it)
.claude/

# Misc
*.log
*.bak
*.tmp

# Raw photo staging area: originals pulled in for GPS extraction and map-pin
# curation (assets/photos/no-location/ included). The resized, actually-used
# copies live in assets/images/places/ and stay tracked; these don't.
assets/photos/
