---
layout: null
---
[
{%- for post in site.posts -%}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%b %-d, %Y" | jsonify }},
    "excerpt": {{ post.description | default: post.excerpt | strip_html | truncate: 200 | jsonify }},
    "type": "Article"
  }{% unless forloop.last %},{% endunless %}
{%- endfor -%}
{%- if site.posts.size > 0 and site.projects.size > 0 -%},{%- endif -%}
{%- for project in site.projects -%}
  {
    "title": {{ project.title | jsonify }},
    "url": {{ project.url | relative_url | jsonify }},
    "date": {{ project.date | date: "%b %-d, %Y" | jsonify }},
    "excerpt": {{ project.description | default: project.excerpt | strip_html | truncate: 200 | jsonify }},
    "type": "Project"
  }{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
